generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEAM_LEADER
  DEVELOPER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  description String?            @db.Text
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  users       User[]
  teams       Team[]
  invitations Invitation[]
  projects    Project[]

  @@map("organizations")
}

model User {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  name           String
  email          String     @unique
  passwordHash   String     @map("password_hash")
  role           Role
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  passwordResetTokens PasswordResetToken[]
  ledTeams            Team[]
  teamMemberships     TeamMember[]
  sentInvitations     Invitation[]
  ledProjects         Project[]            @relation("ProjectLead")
  createdProjects     Project[]            @relation("ProjectCreator")

  @@index([organizationId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Team {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  name           String
  description    String?    @db.Text
  teamLeaderId   String?    @map("team_leader_id")
  status         TeamStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  teamLeader   User?         @relation(fields: [teamLeaderId], references: [id])
  members      TeamMember[]
  invitations  Invitation[]
  projects     ProjectTeam[]

  @@index([organizationId])
  @@index([teamLeaderId])
  @@map("teams")
}

model TeamMember {
  id       String           @id @default(uuid())
  teamId   String           @map("team_id")
  userId   String           @map("user_id")
  joinedAt DateTime         @default(now()) @map("joined_at")
  status   MembershipStatus @default(ACTIVE)

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  teamId         String?          @map("team_id")
  email          String
  invitedById    String           @map("invited_by_id")
  intendedRole   Role             @map("intended_role")
  tokenHash      String           @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  ON_HOLD
  COMPLETED
  PLANNING
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Project {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  name           String
  description    String?       @db.Text
  status         ProjectStatus @default(PLANNING)
  priority       Priority      @default(MEDIUM)
  startDate      DateTime?     @map("start_date") @db.Date
  dueDate        DateTime?     @map("due_date") @db.Date
  teamLeaderId   String        @map("team_leader_id")
  createdById    String        @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  teamLeader   User          @relation("ProjectLead", fields: [teamLeaderId], references: [id])
  createdBy    User          @relation("ProjectCreator", fields: [createdById], references: [id])
  teams        ProjectTeam[]

  @@index([organizationId])
  @@index([teamLeaderId])
  @@map("projects")
}

model ProjectTeam {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  teamId    String   @map("team_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])
  team    Team    @relation(fields: [teamId], references: [id])

  @@unique([projectId, teamId])
  @@index([teamId])
  @@map("project_teams")
}
